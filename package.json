{
  "name": "tsuya-repo",
  "private": true,
  "description": "Build, checks and tests of the tsuya packages. Not published.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/svelte",
    "apps/docs"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/lint-lengths.mjs && node scripts/lint-lines.mjs",
    "test": "vitest run",
    "test:web": "npm run build -w packages/core && playwright test",
    "test:docs": "playwright test --config=playwright.docs.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p . && tsc -p packages/core --noEmit && tsc -p tests && svelte-check --workspace packages/svelte --fail-on-warnings && svelte-check --tsconfig tests/svelte/tsconfig.json --fail-on-warnings && svelte-check --workspace apps/docs --fail-on-warnings",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@sveltejs/package": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.0.3",
    "axe-core": "^4.14.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "publint": "0.3.25",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vitest-browser-svelte": "3.1.0"
  }
}
