{
  "font": {
    "$type": "fontFamily",
    "sans": {"$value": ["Inter", "system-ui", "sans-serif"], "$description": "Every text but code."},
    "mono": {"$value": ["Geist Mono", "ui-monospace", "monospace"], "$description": "Codes, keyboard shortcuts."}
  },
  "type": {
    "$type": "typography",
