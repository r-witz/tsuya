{
  "name": "docs",
  "private": true,
  "description": "The tsuya documentation site: a SvelteKit app, prerendered to static files.",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "generate:props": "npm run -w @tsuya/core -w @tsuya/svelte build && node scripts/generate-props.mjs",
    "sync": "npm run generate:props && svelte-kit sync",
    "dev": "npm run generate:props && vite dev",
    "build": "npm run generate:props && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tsuya/core": "0.1.0",
    "@tsuya/svelte": "0.1.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "mdsvex": "0.12.8",
    "prettier": "3.9.10",
    "shiki": "4.5.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
